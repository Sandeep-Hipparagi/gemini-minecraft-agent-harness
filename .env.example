# Model provider key: Gemini API key required for the agent.
GEMINI_API_KEY=

# Default Gemini model (e.g. gemini-2.5-flash or gemini-2.5-pro).
# GEMINI_MODEL=gemini-2.5-flash

# Sandbox: docker when Docker is running, else local.
# AGENT_SANDBOX=docker
# AGENT_DOCKER_IMAGE=node:22-bookworm

# Defaults for minecraft-agent. Command-line flags override these.
# MC_HOST=localhost
# MC_PORT=25565
# MC_AUTH=offline
# AGENT_NAME=Agent
# AGENT_OBJECTIVE=Gather wood and build a small shelter near spawn
